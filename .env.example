# Canonical public URL
NEXT_PUBLIC_SITE_URL=https://www.lafenicepositano.com

# Transactional inquiry email (server only)
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=La Fenice <requests@lafenicepositano.com>
INQUIRY_TO_EMAIL=info@lafenicepositano.com

# Supabase inquiry persistence (server only; never expose the service-role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for the later public content/media reader
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI virtual concierge (server only)
# Paid demo endpoints remain disabled unless this value is explicitly `true`.
CONCIERGE_DEMO_ENABLED=false
OPENAI_API_KEY=
OPENAI_CONCIERGE_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# At least 32 random characters; signs the demo session and short-lived TTS tokens
CONCIERGE_SIGNING_SECRET=
